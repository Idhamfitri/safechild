<!--
  android/app/src/main/res/xml/accessibility_service_config.xml

  Configures what screen events the flutter_accessibility_service plugin captures.

  accessibilityEventTypes:
    typeWindowContentChanged — fires when app content updates (new message, page load)
    typeViewTextChanged      — fires when text field changes

  canRetrieveWindowContent:
    true — allows reading text from the currently visible window

  notificationTimeout:
    100ms — minimum delay between events to avoid flooding
-->
